{
  "name": "fetchbasequery",
  "version": "1.0.2",
  "description": "Library for easily make HTTP queries without mass of boilerplate code.",
  "type": "module",
  "main": "src/fetchBaseQuery.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./decorators": {
      "types": "./src/decorators/index.d.ts",
      "import": "./src/decorators/index.js"
    },
    "./middlewares": {
      "types": "./src/middlewares/index.d.ts",
      "import": "./src/middlewares/index.js"
    },
    "./utils": {
      "types": "./src/utils/index.d.ts",
      "import": "./src/utils/index.js"
    }
  },
  "scripts": {
    "test": "node tests/index.js"
  },
  "keywords": [
    "fetch",
    "fetchBaseQuery",
    "middleware",
    "retry",
    "retryOnError",
    "retryOn429",
    "muteErrors",
    "json"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.5"
  }
}
